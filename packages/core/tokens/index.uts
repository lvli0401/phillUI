export function tokensToCssVars(tokens: any): any {
	const vars: any = {}
	const keys = Object.keys(tokens)
	keys.forEach((key: string) => {
		const cssVar = `--tsm-${key.replace(/([A-Z])/g, '-$1').toLowerCase()}`
		vars[cssVar] = tokens[key]
	})
	return vars
}
