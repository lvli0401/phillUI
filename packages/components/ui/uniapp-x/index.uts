import {
  initThemeMode,
  getThemeMode,
  setThemeMode,
  toggleThemeMode,
  useThemeTokens,
  useThemeCssVars,
} from '@/uni_modules/@phill-component/tokens/index.uts';

const install = (app: VueApp): void => {
	initThemeMode();
	app.config.globalProperties.$tsm = { getThemeMode, setThemeMode, toggleThemeMode }
	// #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
	app.config.globalProperties.$tsm.tokens = useThemeTokens()
	// #endif
	// #ifdef WEB || MP-WEIXIN
	app.config.globalProperties.$tsm.cssVars = useThemeCssVars()
	// #endif
}

export default {
    install
}
