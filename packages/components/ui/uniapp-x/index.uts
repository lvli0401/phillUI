// 关于颜色的配置，特殊场景使用
import color from './libs/config/color.uts'
import * as index from './libs/function/index.uts'
import { getThemeMode, initThemeMode, setThemeMode, toggleThemeMode, useThemeCssVars, useThemeTokens } from './libs/theme/index.uts'
export {config, color}
export {mixin, mpMixin}
export * from './libs/function/index.uts'
export { getThemeMode, initThemeMode, setThemeMode, toggleThemeMode, useThemeCssVars, useThemeTokens }
