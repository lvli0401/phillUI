{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": false,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "allowArbitraryExtensions": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "types": ["@dcloudio/types"]
  },
  "include": [
    "components/**/*.vue",
    "components/**/*.uvue",
    "components/**/*.uts",
    "components/**/*.ts",
    "components/**/*.js",
    "libs/**/*.uvue",
    "libs/**/*.uts",
    "libs/**/*.ts",
    "libs/**/*.js",
    "types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist", "unpackage"]
}
