<template>
	<view
	    class="up-icon"
	    @tap="clickHandler"
	    :class="['up-icon--' + labelPos]"
	>
		<image
		    class="up-icon__img"
		    v-if="isImg"
		    :src="name"
		    :mode="imgMode"
		    :style="imgMergedStyle"
		></image>
		<image
		    v-else
		    class="up-icon__img"
		    :src="imgSrc"
		    :mode="imgMode"
		    :style="imgMergedStyle"
		></image>
		<!-- 这里进行空字符串判断，如果仅仅是v-if="label"，可能会出现传递0的时候，结果也无法显示 -->
		<text
		    v-if="label !== ''" 
		    class="up-icon__label"
		    :style="labelStyle"
		>{{ label }}</text>
	</view>
</template>

<script setup lang="uts">
	import { addUnit, addStyle, getPx } from '../../libs/function/index.uts';
	// 引入图标数据源（X 端使用 .uts 映射，避免解析 .js 失败）
	import iconsSvg from '@/uni_modules/@phill-component/icons/dist/uniapp/icons-svg.uts'
	import { propsIcon } from './props.uts';
	import config from '../../libs/config/config';

	const props = defineProps({
		// 每个组件都有的父组件传递的样式，可以为字符串或者对象形式
		customStyle: {
			type: [UTSJSONObject, String],
			default: () : UTSJSONObject => ({})
		},
		customClass: {
			type: String,
			default: ''
		},
		// 跳转的页面路径
		url: {
			type: String,
			default: ''
		},
		// 页面跳转的类型
		linkType: {
			type: String,
			default: 'navigateTo'
		},
		// 图标名称，见示例图标集
		name: {
			type: String,
			default: ''
		},
		// 图标颜色,可接受主题色
		color: {
			type: String,
			default: ''
		},
		// 图标字体大小，单位px
		size: {
			type: [String, Number],
			default: '16px'
		},
		// 是否显示粗体
		bold: {
			type: Boolean,
			default: false
		},
		// 点击图标的时候传递事件出去的index（用于区分点击了哪一个）
		index: {
			type: [String, Number],
			default: ''
		},
		// 图标按下去的样式类，用法同uni的view组件的hoverClass参数，详情见官网
		hoverClass: {
			type: String,
			default: ''
		},
		// 自定义扩展前缀，方便用户扩展自己的图标库
		customPrefix: {
			type: String,
			default: 'upicon'
		},
		// 图标右侧的label文字
		label: {
			type: [String, Number],
			default: ''
		},
		// label相对于图标的位置，只能right或bottom
		labelPos: {
			type: String,
			default: 'right'
		},
		// label字体大小，单位px
		labelSize: {
			type: [String, Number],
			default: '15px'
		},
		// 图标右侧的label文字颜色
		labelColor: {
			type: String,
			default: ''
		},
		// label与图标的距离，单位px
		space: {
			type: [String, Number],
			default: '3px'
		},
		// 图片的mode
		imgMode: {
			type: String,
			default: ''
		},
		// 显示图片小图标时的宽度
		width: {
			type: [String, Number],
			default: ''
		},
		// 显示图片小图标时的高度
		height: {
			type: [String, Number],
			default: ''
		},
		// 图标在垂直方向上的定位 用于解决某些情况下，让图标垂直居中的用途
		top: {
			type: [String, Number],
			default: 0
		},
		// 是否阻止事件传播
		stop: {
			type: Boolean,
			default: false
		},
	})
	
	const emit = defineEmits(['click'])


	const uClasses = computed(() : string => {
		const classes = [] as string[]
		classes.push(props.customPrefix + '-' + props.name)
		if (props.customPrefix == 'upicon') {
			classes.push('up-icon-custom')
		} else {
			classes.push(props.customPrefix)
		}
		if (props.color != '' && (config['type'] as string[]).includes(props.color)) {
			classes.push('up-icon__icon--' + props.color)
		}
		return classes.join(' ')
	})

	const iconStyle = computed(() : UTSJSONObject => {
		const themes = config['type'] as string[]
		const style = {
			fontSize: addUnit(props.size),
			lineHeight: addUnit(props.size),
			fontWeight: props.bold ? 'bold' : 'normal',
			top: addUnit(props.top)
		} as UTSJSONObject
		if (props.color != '' && !themes.includes(props.color)) {
			style['color'] = props.color
		}
		return style
	})
	
	// 判断传入的name属性，是否图片路径，只要带有"/"均认为是图片形式
	const isImg = computed(() : boolean => {
		return props.name.indexOf('/') != -1
	})
	
	const imgStyle = computed(() : UTSJSONObject => {
		let style = {} as UTSJSONObject
		// 如果设置width和height属性，则优先使用，否则使用size属性
		style['width'] = props.width != '' ? addUnit(props.width) : addUnit(props.size)
		style['height'] = props.height != '' ? addUnit(props.height) : addUnit(props.size)
		return style
	})
	
	const imgMergedStyle = computed(() : UTSJSONObject => {
		const base = imgStyle.value as UTSJSONObject
		const extraRaw = addStyle(props.customStyle, 'object')
		const extra = (typeof extraRaw == 'object') ? (extraRaw as UTSJSONObject) : ({} as UTSJSONObject)
		const out = {} as UTSJSONObject
		UTSJSONObject.keys(base).forEach((k: string) => { out[k] = base[k] })
		UTSJSONObject.keys(extra).forEach((k: string) => { out[k] = extra[k] })
		return out
	})

	const labelStyle = computed(() : UTSJSONObject => {
		const out = {} as UTSJSONObject
		if (props.labelColor != '') out['color'] = props.labelColor
		out['fontSize'] = addUnit(props.labelSize)
		out['marginLeft'] = props.labelPos == 'right' ? addUnit(props.space) : 0
		out['marginTop'] = props.labelPos == 'bottom' ? addUnit(props.space) : 0
		out['marginRight'] = props.labelPos == 'left' ? addUnit(props.space) : 0
		out['marginBottom'] = props.labelPos == 'top' ? addUnit(props.space) : 0
		return out
	})
	
	// 通过图标名，查找对应的图标
	const imgSrc = computed(() : string => {
		// X 端不进行动态导入，直接使用静态映射（注意空值保护），失败回退图片
		let recAny: UTSJSONObject | null = null
		try {
			const mapAny: UTSJSONObject | null = iconsSvg as UTSJSONObject
			recAny = mapAny != null ? mapAny[props.name] as UTSJSONObject : null
		} catch (e) {
			recAny = null
		}
		if (recAny != null && typeof recAny == 'object') {
			const direct = recAny['dataUri'] as string | null
			if (direct != null && direct.length > 0) return direct
			const inner = recAny['inner'] as string | null
			if (inner != null && inner.length > 0) return 'data:image/svg+xml;utf8,' + encodeURIComponent(inner)
		}
		return `/uni_modules/@phill-component/icons/dist/uniapp/images/${props.name}.svg`
	})

	// 方法
	function clickHandler(e: UniPointerEvent) {
		emit('click', props.index)
		// 是否阻止事件冒泡
		if (props.stop) {
			e.stopPropagation()
		}
	}

	// X 端不进行动态导入，直接使用静态映射

	// 移除字体加载逻辑，统一使用 data URI / 图片方案
</script>

<style lang="scss">
	@import "../../libs/css/components.scss";

	$up-icon-primary: $up-primary !default;
	$up-icon-success: $up-success !default;
	$up-icon-info: $up-info !default;
	$up-icon-warning: $up-warning !default;
	$up-icon-error: $up-error !default;
	$up-icon-label-line-height: 1 !default;

	.up-icon {
		display: flex;
		align-items: center;

		&--left {
			flex-direction: row-reverse;
			align-items: center;
		}

		&--right {
			flex-direction: row;
			align-items: center;
		}

		&--top {
			flex-direction: column-reverse;
			justify-content: center;
		}

		&--bottom {
			flex-direction: column;
			justify-content: center;
		}

		&__img {
			height: auto;
		}

		&__label {
			line-height: $up-icon-label-line-height;
		}
	}
</style>
