import { defineMixin } from '../../libs/vue'
import defProps from './navbar'

let crtProp = defProps['navbar'] as any

export const propsNavbar = defineMixin({
	props: {
		title: {
			type: [String, Number],
			default: crtProp['title']
		},
		bgColor: {
			type: String,
			default: crtProp['bgColor']
		},
		height: {
			type: [String, Number],
			default: crtProp['height']
		},
		fixed: {
			type: Boolean,
			default: crtProp['fixed']
		},
		placeholder: {
			type: Boolean,
			default: crtProp['placeholder']
		},
		safeAreaInsetTop: {
			type: Boolean,
			default: crtProp['safeAreaInsetTop']
		},
		autoBack: {
			type: Boolean,
			default: crtProp['autoBack']
		},
		leftText: {
			type: [String, Number],
			default: crtProp['leftText']
		},
		rightText: {
			type: [String, Number],
			default: crtProp['rightText']
		},
		zIndex: {
			type: [String, Number],
			default: crtProp['zIndex']
		},
		customStyle: {
			type: [Object, String],
			default: crtProp['customStyle']
		},
		customClass: {
			type: String,
			default: crtProp['customClass']
		},
		stop: {
			type: Boolean,
			default: crtProp['stop']
		}
	}
})
