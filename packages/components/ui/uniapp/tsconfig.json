{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": false,
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/uni_modules/@phill-component/tokens/*": ["../../../core/tokens/dist/*"]
    },
    "types": ["@dcloudio/types"]
  },
  "include": ["index.ts", "components/**/*.vue", "components/**/*.ts", "libs/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "unpackage", "../uniapp-x"]
}
