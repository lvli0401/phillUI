{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "outputs": ["packages/**/dist/**"],
      "inputs": [
        "packages/**/src/**/*",
        "packages/**/package.json",
        "packages/**/tsconfig.json",
        "packages/**/rollup.config.*"
      ]
    },
    "release-core-tokens": {
      "dependsOn": ["build"],
      "outputs": [],
      "env": ["PHILLUI_PUBLISH"],
      "inputs": ["packages/core/tokens/**/*", "pnpm-lock.yaml"],
      "cache": false
    },
    "release-core-icons": {
      "dependsOn": ["release-core-tokens"],
      "outputs": [],
      "env": ["PHILLUI_PUBLISH"],
      "inputs": ["packages/core/icons/**/*", "pnpm-lock.yaml"],
      "cache": false
    },
    "release-components-ui": {
      "dependsOn": ["release-core-icons"],
      "outputs": [],
      "env": ["PHILLUI_PUBLISH"],
      "inputs": [
        "packages/components/ui/**/*",
        "pnpm-lock.yaml",
        "packages/core/tokens/**/*"
      ],
      "cache": false
    },
    "release": {
      "dependsOn": ["release-components-ui"],
      "outputs": [],
      "env": ["PHILLUI_PUBLISH"],
      "cache": false
    }
  },
  "globalDependencies": [
    "packages/core/tokens/**/*",
    "packages/core/hooks/**/*"
  ]
}
