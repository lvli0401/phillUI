<template>
	<view class="content">
		<image class="logo" src="/static/logo.png"></image>
		<view class="text-area">
			<text class="title">{{title}}</text>
		</view>
		<up-button @click="navToIcon" class="button" type="success">
			进入图标测试页
		</up-button>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	const title = ref('Hello')

	const navToIcon = () => {
		uni.navigateTo({
			url: '/pages/components/icon-test'
		})
	}
</script>

<style>
	.content {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}

	.logo {
		height: 100px;
		width: 100px;
		margin: 100px auto 25px auto;
	}

	.text-area {
		display: flex;
		justify-content: center;
	}

	.title {
		font-size: 18px;
		color: #8f8f94;
		text-align: center;
	}

	.button {
		margin-top: 25px;
		width: 200px;
	}
</style>